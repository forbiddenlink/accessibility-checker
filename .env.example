# Copy to .env.local. Every value here is optional in development.

# Canonical origin. Used for sitemap/robots generation and metadata.
# Without it, next-sitemap falls back to the deployed Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Arcjet — bot detection + shield on /api/*. Unset in development, /api/* is
# unprotected. https://app.arcjet.com
ARCJET_KEY=

# Upstash Redis — rate limits /api/* to 20 requests / 10s per IP. Both must be
# set together or rate limiting is disabled entirely.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
