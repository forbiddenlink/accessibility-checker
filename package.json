{
  "name": "accessibility-checker",
  "version": "0.1.0",
  "description": "Automated web accessibility checker using axe-core and WCAG 2.1 / APCA contrast analysis",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security": "pnpm audit --audit-level high",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@arcjet/next": "^1.12.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "apca-w3": "^0.1.9",
    "axe-core": "^4.13.0",
    "jspdf": "^4.2.1",
    "next": "^16.3.4",
    "playwright-core": "^1.64.0",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/eslintrc": "3.3.7",
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "next-sitemap": "4.2.3",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-nesting": "14.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.2 <2",
      "brace-expansion": ">=5.0.12 <6",
      "browserslist": ">=4.28.7 <5",
      "dompurify": ">=3.4.17 <4",
      "fflate": ">=0.8.3 <0.9",
      "glob": ">=10.5.0 <11",
      "js-yaml": ">=4.3.1 <5",
      "minimatch@3.1.5>brace-expansion": ">=1.1.21 <2",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss": ">=8.5.23 <9",
      "postcss-selector-parser": ">=7.1.3 <8",
      "sharp": ">=0.35.0 <1",
      "undici": ">=7.30.1 <8",
      "uuid": ">=11.1.1 <15",
      "vite": ">=8.3.3 <9",
      "source-map-js@1": ">=1.2.2 <2.0.0"
    }
  },
  "packageManager": "pnpm@10.34.7"
}
