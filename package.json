{
  "name": "accessibiliy-checker",
  "version": "0.1.0",
  "description": "Automated web accessibility checker using axe-core, APCA contrast analysis, and HTML validation",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@arcjet/next": "^1.4.0",
    "@headlessui/react": "^2.2.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "apca-w3": "^0.1.9",
    "axe-core": "^4.12.1",
    "html-validator": "^6.0.1",
    "jspdf": "^4.2.1",
    "next": "^16.2.9",
    "next-axiom": "^1.5.0",
    "next-safe-action": "^8.5.4",
    "nuqs": "^2.8.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.10",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6",
    "vitest": "^4.1.8",
    "@eslint/eslintrc": "^3.3.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.2",
      "glob": ">=10.5.0",
      "uuid": ">=11.1.1"
    }
  }
}
