{
  "name": "accessibility-checker",
  "version": "0.1.0",
  "description": "Automated web accessibility checker using axe-core and WCAG 2.1 / APCA contrast analysis",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security": "pnpm audit --audit-level high",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@arcjet/next": "^1.5.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "apca-w3": "^0.1.9",
    "axe-core": "^4.12.1",
    "jspdf": "^4.2.1",
    "next": "^16.2.11",
    "playwright-core": "^1.61.1",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.14.6",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.18",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.9.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.2 <2",
      "brace-expansion": ">=5.0.9 <6",
      "browserslist": ">=4.28.7 <5",
      "dompurify": ">=3.4.13 <4",
      "fflate": ">=0.8.3 <0.9",
      "glob": ">=10.5.0 <11",
      "js-yaml": ">=4.3.1 <5",
      "minimatch@3.1.5>brace-expansion": ">=1.1.12 <2",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss": ">=8.5.23 <9",
      "postcss-selector-parser": ">=7.1.3 <8",
      "sharp": ">=0.35.0 <1",
      "undici": ">=7.28.0 <8",
      "uuid": ">=11.1.1 <15",
      "vite": ">=8.0.16 <9"
    }
  },
  "packageManager": "pnpm@10.18.0"
}
